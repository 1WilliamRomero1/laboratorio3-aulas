<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="940.0" spacing="14.0" styleClass="fondo" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ufg.aulas.controladores.HomeController">
   <padding>
      <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label styleClass="titulo" text="Registro de aulas" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsuario" styleClass="subtitulo" />
            <Button onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
      </HBox>
      <GridPane hgap="14.0" styleClass="tarjeta" vgap="12.0">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </padding>
         <columnConstraints>
            <ColumnConstraints minWidth="110.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" />
            <ColumnConstraints minWidth="110.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" />
         </columnConstraints>
         <children>
            <Label styleClass="etiqueta" text="Nombre / código" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Ej. B-204" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="etiqueta" text="Edificio" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtEdificio" promptText="Ej. Edificio B" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="etiqueta" text="Planta" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbPlanta" maxWidth="1.7976931348623157E308" promptText="Seleccione la planta" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="etiqueta" text="Capacidad" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtCapacidad" promptText="Personas que caben" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label styleClass="etiqueta" text="Tipo de aula" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbTipoAula" maxWidth="1.7976931348623157E308" promptText="Seleccione el tipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label styleClass="etiqueta" text="Responsable" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtResponsable" promptText="Persona a cargo" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Label styleClass="etiqueta" text="Estado" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Seleccione el estado" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3">
               <children>
                  <Button onAction="#limpiar" styleClass="boton-secundario" text="Limpiar" />
                  <Button onAction="#guardar" styleClass="boton-primario" text="Guardar" />
               </children>
            </HBox>
         </children>
      </GridPane>
      <Label styleClass="subtitulo" text="Aulas registradas" />
      <TableView fx:id="tablaAulas" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="110.0" text="Nombre" />
            <TableColumn fx:id="colEdificio" prefWidth="140.0" text="Edificio" />
            <TableColumn fx:id="colPlanta" prefWidth="70.0" text="Planta" />
            <TableColumn fx:id="colCapacidad" prefWidth="90.0" text="Capacidad" />
            <TableColumn fx:id="colTipo" prefWidth="140.0" text="Tipo" />
            <TableColumn fx:id="colResponsable" prefWidth="170.0" text="Responsable" />
            <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
